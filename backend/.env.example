# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# If left blank, CampusX starts an embedded MongoDB instance automatically for local testing
MONGODB_URI=

# JWT Secret
JWT_SECRET=campusx_secret_jwt_key_super_secure_2025

# Optional: Cloudinary Credentials (if blank, uploads are stored locally in /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Restrict registration to specific college domains (comma-separated, e.g. iitb.ac.in,du.ac.in,bits.ac.in)
ALLOWED_EMAIL_DOMAINS=

